# AvisaBus — variables de entorno (prefijo AVISABUS_).
# Copia este fichero a .env en la raíz del repositorio (./init.sh setup lo hace) y ajusta lo
# necesario. El backend se ejecuta desde backend/ y lee ../.env (este .env de la raíz) y, si
# existe, backend/.env, cuyos valores prevalecen. Las variables de entorno del proceso prevalecen
# sobre ambos ficheros.
# Todas las variables tienen un valor por defecto seguro para desarrollo.

# Entorno de ejecución: dev | test | prod.
AVISABUS_ENV=dev

# Nivel de log (DEBUG, INFO, WARNING, ERROR). Los logs se emiten en JSON.
AVISABUS_LOG_LEVEL=INFO

# URL de la base de datos SQLite (relativa al directorio backend/).
AVISABUS_DATABASE_URL=sqlite:///../data/avisabus.sqlite

# URL pública del frontend (base de los enlaces de los QR de parada).
AVISABUS_PUBLIC_BASE_URL=http://localhost:5173

# Secreto HMAC con el que se firman los tokens de los QR de parada.
# Obligatorio en prod (al menos 32 bytes): sin él, la API y la CLI no arrancan. Cambiarlo
# invalida todos los QR impresos (hay que regenerarlos e imprimirlos de nuevo).
# De este secreto se deriva también la clave del hash del identificador de dispositivo
# (device_hash): cambiarlo rompe la relación entre los dispositivos y sus avisos existentes, que
# dejan de verse hasta que caducan.
# En dev y test, si no se define, se usa un secreto de desarrollo fijo y se registra la
# advertencia security.dev_stop_token_secret. Genera uno con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# AVISABUS_STOP_TOKEN_SECRET=

# GTFS: días antes de feed_end_date a partir de los cuales `avisabus gtfs import` y
# `avisabus gtfs info` avisan de que el feed caduca (y registran gtfs.feed_expiring).
AVISABUS_GTFS_EXPIRY_WARNING_DAYS=7

# GTFS: filas por lote al insertar el feed en la base de datos durante la importación.
AVISABUS_GTFS_BATCH_SIZE=10000

# Ocupación simulada (RF-14, RF-15): capacidad total y asientos de un autobús. Los asientos no
# pueden superar la capacidad (si no, la aplicación y la CLI no arrancan).
AVISABUS_OCCUPANCY_CAPACITY=90
AVISABUS_OCCUPANCY_SEATS=28

# Ocupación simulada: semilla de la variación determinista entre viajes.
AVISABUS_OCCUPANCY_SEED=avisabus

# Ocupación: umbrales de nivel sobre ocupados / capacidad. Por debajo de MEDIUM es FREE (libre),
# por debajo de FULL es MEDIUM (medio) y en otro caso FULL (lleno). Deben cumplir
# 0 < MEDIUM < FULL <= 1 y, con la capacidad configurada, cada nivel debe admitir algún número
# entero de plazas ocupadas (p. ej. capacidad 3 con 0.50 y 0.60 no tiene ninguno MEDIUM); si no,
# la aplicación y la CLI no arrancan. Los forzados de demo (`avisabus occupancy override`) usan el
# punto medio de la banda de cada nivel.
AVISABUS_OCCUPANCY_THRESHOLD_MEDIUM=0.50
AVISABUS_OCCUPANCY_THRESHOLD_FULL=0.85

# Fuente de los tiempos de llegada en tiempo real: http (el SAE de EMT) | replay (una sesión
# grabada en AVISABUS_SAE_REPLAY_DIR). Sin definir: replay si AVISABUS_ENV=test y http en dev y
# prod. Las dos van detrás de la caché de AVISABUS_SAE_CACHE_TTL_S.
# AVISABUS_ARRIVALS_SOURCE=

# SAE (tiempos de llegada en tiempo real de EMT València, sae_arrivals_source).
# Plantilla de la URL de la página QR.php de una parada; debe contener {stop_id}.
AVISABUS_SAE_URL_TEMPLATE=https://www.emtvalencia.es/QR.php?sec=est&p={stop_id}

# SAE: timeout de cada petición, en segundos.
AVISABUS_SAE_TIMEOUT_S=3

# SAE: contacto (p. ej. un correo) que se añade al User-Agent de las peticiones:
# "AvisaBus/<versión> (TFM; <contacto>)". Conviene definirlo antes de consultar o grabar el SAE.
AVISABUS_SAE_CONTACT=

# SAE: segundos que se reutiliza la respuesta de una parada antes de volver a consultarla (RF-08).
AVISABUS_SAE_CACHE_TTL_S=20

# SAE: segundos durante los que, tras un fallo de una parada, se responde "no disponible" sin
# volver a consultarla.
AVISABUS_SAE_ERROR_TTL_S=5

# SAE: máximo de consultas simultáneas al SAE, sumando todas las paradas.
AVISABUS_SAE_MAX_CONCURRENCY=4

# Replay: carpeta de la sesión grabada (con session.json) que se reproduce cuando la fuente es
# replay (relativa al directorio backend/). Si no existe o su source_format es desconocido, la
# API no arranca.
AVISABUS_SAE_REPLAY_DIR=tests/fixtures/sae_recordings/stop_508_peak

# Llegadas de una parada (stop_arrivals_api).
# Emparejamiento de cada llegada del SAE con un viaje programado: diferencia máxima, en minutos,
# entre la hora del SAE y la hora programada del viaje. Más allá, la llegada queda sin viaje (sin
# ocupación) y no admite solicitud de parada (no se sabe qué autobús es).
AVISABUS_TRIP_MATCH_TOLERANCE_MIN=10

# Solicitudes de parada (alert_create): una llegada solo admite solicitud si se sabe qué autobús
# es (viaje emparejado) y llega en, como máximo, estos minutos (can_alert de la API de llegadas).
AVISABUS_ALERT_MAX_LEAD_MIN=30

# Solicitudes de parada: minutos desde su creación tras los que una solicitud caduca (RF-21);
# también es su expires_at.
AVISABUS_ALERT_MAX_AGE_MIN=30

# Límite de peticiones a POST /api/v1/alerts (RNF-07): como máximo RATE_DEVICE por dispositivo y
# RATE_IP por dirección IP en una ventana deslizante de RATE_WINDOW_MIN minutos. Cuentan todas las
# peticiones que llegan a procesarse (también las rechazadas, incluidas las 429), salvo las que
# devuelven una solicitud ya existente (200). Al superarlo se responde 429 con Retry-After. Los
# contadores viven solo en memoria (se pierden al reiniciar) y nunca se registran.
AVISABUS_ALERT_RATE_DEVICE=10
AVISABUS_ALERT_RATE_IP=30
AVISABUS_ALERT_RATE_WINDOW_MIN=10

# Respaldo por horario cuando el SAE no responde (RF-09): ventana, en minutos, y número máximo de
# pasadas programadas por línea y sentido que se devuelven.
AVISABUS_SCHEDULED_WINDOW_MIN=90
AVISABUS_SCHEDULED_PER_DIRECTION=2

# Sentido de una llegada a partir del destino del SAE: similitud mínima (0–1) entre el texto del
# SAE y un headsign del GTFS para elegir ese sentido.
AVISABUS_DIRECTION_MIN_SCORE=0.2

# Fichero JSON de correcciones del sentido (relativo al directorio backend/), con entradas
# "{línea}|{destino del SAE tal cual}": "{headsign del GTFS}". Vacío: sin correcciones. Al arrancar
# se ignoran (con el evento arrivals.override_invalid) las entradas cuya línea o headsign no existe
# en la red activa; si el fichero no se puede leer o no es un objeto JSON de textos, la API no
# arranca. El fichero inicial está vacío: con las reglas actuales ningún caso observado lo necesita.
AVISABUS_DIRECTION_OVERRIDES_FILE=config/direction_overrides.json

# Tiempo real (realtime_events): WebSocket del pasajero /ws/passenger.
# Máximo de conexiones WebSocket abiertas a la vez; las nuevas se cierran con el código 1013.
AVISABUS_WS_MAX_CONNECTIONS=500

# Segundos entre dos mensajes {"type": "ping"} del servidor en cada conexión.
AVISABUS_WS_PING_INTERVAL_S=25

# Segundos que el servidor espera el primer mensaje (hello) antes de cerrar con el código 4408.
AVISABUS_WS_HELLO_TIMEOUT_S=5

# Eventos pendientes por suscripción; si se llena, la conexión se cierra con el código 4429 y el
# cliente se reconecta con una instantánea nueva.
AVISABUS_EVENT_QUEUE_SIZE=100
