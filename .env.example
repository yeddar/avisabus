# AvisaBus — variables de entorno (prefijo AVISABUS_).
# Copia este fichero a .env en la raíz del repositorio (./init.sh setup lo hace) y ajusta lo
# necesario. El backend se ejecuta desde backend/ y lee ../.env (este .env de la raíz) y, si
# existe, backend/.env, cuyos valores prevalecen. Las variables de entorno del proceso prevalecen
# sobre ambos ficheros.
# Todas las variables tienen un valor por defecto seguro para desarrollo.

# Entorno de ejecución: dev | test | prod.
AVISABUS_ENV=dev

# Nivel de log (DEBUG, INFO, WARNING, ERROR). Los logs se emiten en JSON.
AVISABUS_LOG_LEVEL=INFO

# URL de la base de datos SQLite (relativa al directorio backend/).
AVISABUS_DATABASE_URL=sqlite:///../data/avisabus.sqlite

# URL pública del frontend (base de los enlaces de los QR de parada).
AVISABUS_PUBLIC_BASE_URL=http://localhost:5173

# GTFS: días antes de feed_end_date a partir de los cuales `avisabus gtfs import` y
# `avisabus gtfs info` avisan de que el feed caduca (y registran gtfs.feed_expiring).
AVISABUS_GTFS_EXPIRY_WARNING_DAYS=7

# GTFS: filas por lote al insertar el feed en la base de datos durante la importación.
AVISABUS_GTFS_BATCH_SIZE=10000

# Ocupación simulada (RF-14, RF-15): capacidad total y asientos de un autobús. Los asientos no
# pueden superar la capacidad (si no, la aplicación y la CLI no arrancan).
AVISABUS_OCCUPANCY_CAPACITY=90
AVISABUS_OCCUPANCY_SEATS=28

# Ocupación simulada: semilla de la variación determinista entre viajes.
AVISABUS_OCCUPANCY_SEED=avisabus

# Ocupación: umbrales de nivel sobre ocupados / capacidad. Por debajo de MEDIUM es FREE (libre),
# por debajo de FULL es MEDIUM (medio) y en otro caso FULL (lleno). Deben cumplir
# 0 < MEDIUM < FULL <= 1 (si no, la aplicación y la CLI no arrancan).
AVISABUS_OCCUPANCY_THRESHOLD_MEDIUM=0.50
AVISABUS_OCCUPANCY_THRESHOLD_FULL=0.85
