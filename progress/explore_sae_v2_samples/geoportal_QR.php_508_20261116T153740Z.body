n Sans,sans-serif}body{overflow:hidden;color:#0f0f0f}h2{font-family:Open Sans,sans-serif;font-weight:400}h2{font-size:1.8em}html,body{height:100%;margin:0;padding:0;-webkit-font-smoothing:antialiased}*{box-sizing:border-box}@media print{html,body{margin:0!important;padding:0!important}}</style><link rel="stylesheet" href="styles.8e449b71cb0f4426.css" media="print" onload="this.media='all'"><noscript><link rel="stylesheet" href="styles.8e449b71cb0f4426.css"></noscript></head>

  <body>
    <emt-root id="emt-root">
      <style type="text/css">
        html,
        body {
          height: 100vh;
          width: 100vw;
          padding: 0;
          margin: 0;
          overflow: hidden;
        }

        body emt-root {
          background: #e9edf2;
          height: 100%;
          display: flex;
          justify-content: center;
          align-items: center;
        }

        emt-root {
          display: flex;
        }

        .loading {
          text-align: center;
          width: 50%;
          height: 50%;
        }

        .loading h2 {
          color: rgb(129, 129, 129);
          margin: 0;
          font: 0.8em verdana;
          text-transform: uppercase;
          letter-spacing: 0.1em;
        }

        .loading #emtv {
          width: 100%;
          max-width: 350px;
        }

        .loading #emtv_footer {
          width: 100%;
        }

        /*
* Loading Dots
* Can we use pseudo elements here instead :after?
*/
        .loading span {
          display: inline-block;
          vertical-align: middle;
          width: 0.6em;
          height: 0.6em;
          margin: 0.19em;
          background: #df2e2e;
          border-radius: 0.6em;
          animation: loading 1s infinite alternate;
        }

        /*
* Dots Colors
* Smarter targeting vs nth-of-type?
*/
        .loading span:nth-of-type(2) {
          background: #a73737;
          animation-delay: 0.2s;
        }

        .loading span:nth-of-type(3) {
          background: #a36a6a;
          animation-delay: 0.4s;
        }

        .loading span:nth-of-type(4) {
          background: #a09696;
          animation-delay: 0.6s;
        }

        .loading span:nth-of-type(5) {
          background: #a36a6a;
          animation-delay: 0.8s;
        }

        .loading span:nth-of-type(6) {
          background: #a73737;
          animation-delay: 1s;
        }

        .loading span:nth-of-type(7) {
          background: #df2e2e;
          animation-delay: 1.2s;
        }

        /*
* Animation keyframes
* Use transition opacity instead of keyframes?
*/
        @keyframes loading {
          0% {
            opacity: 0;
          }

          100% {
            opacity: 1;
          }
        }
      </style>

      <div class="loading">
        <img id="emtv" src="assets/images/logos/EMT_Valencia_logo.svg">
        <h2>Planificador de rutas</h2>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <img id="emtv_footer" src="assets/images/logos/Faldon_NEXTGENERATION_ok.png">
      </div>
    </emt-root>
  <script src="runtime.b07300d967db579c.js" type="module"></script><script src="polyfills.4f2eb2aa40f7b167.js" type="module"></script><script src="main.d95692a529c1bafc.js" type="module"></script>

</body></html>