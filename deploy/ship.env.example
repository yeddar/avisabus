# deploy/ship.sh and deploy/gtfs-update.sh: where AvisaBus is deployed. Copy this file to
# deploy/ship.env (not versioned, .gitignore) and fill it in. It is read on the Mac only.

# SSH destination of the Raspberry Pi (user@host or an alias of ~/.ssh/config). The SSH user must
# be able to run `docker` (docker group) without a password.
RPI_HOST=pi@raspberrypi.local

# Directory of AvisaBus on the Raspberry Pi (absolute path, no spaces). It holds compose.yaml,
# nginx/, .env.prod (created by hand, never copied by ship.sh), .env (the version in use, written
# by ship.sh) and data/ (database and GTFS).
RPI_DIR=/home/pi/avisabus

# Public URL, as configured in NPM, checked by deploy/smoke.sh after each deployment.
PUBLIC_URL=https://<tu-dominio>

# Docker network of Nginx Proxy Manager on the Raspberry Pi (`docker network ls`).
NPM_NETWORK=npm_default
