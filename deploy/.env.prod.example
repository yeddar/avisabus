# AvisaBus — configuración de producción (Raspberry Pi, deploy/compose.yaml).
#
# Copia este fichero a deploy/.env.prod EN LA RASPBERRY (dentro de RPI_DIR) y rellena los valores
# marcados como obligatorios. deploy/.env.prod no se versiona (.gitignore) ni lo copia ship.sh:
# contiene el secreto de los QR. Lo leen los contenedores (env_file de compose.yaml).
#
# Las rutas son absolutas DENTRO DEL CONTENEDOR backend: /data es el volumen de la base de datos
# (./data en RPI_DIR) y /app/replay/stop_508_peak, la grabación del SAE incluida en la imagen.
# Todas las variables están documentadas con detalle en el .env.example de la raíz del repositorio;
# aquí se repiten con el valor de producción. Tras cambiar este fichero:
#   docker compose up -d backend        (en RPI_DIR; recrea el contenedor con la nueva config)
#
# Con AVISABUS_ENV=prod la API y la CLI NO ARRANCAN si falta el secreto, si la fuente es http y
# falta el contacto, o si la URL pública no empieza por https://.

# Entorno de ejecución.
AVISABUS_ENV=prod

# Nivel de log (los logs se emiten en JSON, sin IP ni identificadores).
AVISABUS_LOG_LEVEL=INFO

# Base de datos SQLite en el volumen /data (cuatro barras: ruta absoluta).
AVISABUS_DATABASE_URL=sqlite:////data/avisabus.sqlite

# URL pública del servicio, con https:// (OBLIGATORIO). Es la base de los enlaces de los QR de
# parada: cambiarla obliga a regenerar e imprimir de nuevo los QR.
AVISABUS_PUBLIC_BASE_URL=https://<tu-dominio>

# Secreto HMAC de los QR de parada y del hash de dispositivo (OBLIGATORIO, al menos 32 bytes).
# Genéralo una vez y guárdalo aparte; cambiarlo invalida todos los QR impresos:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
AVISABUS_STOP_TOKEN_SECRET=<obligatorio>

# Contacto (p. ej. un correo) que EMT verá en el User-Agent de las consultas al SAE:
# "AvisaBus/<versión> (TFM; <contacto>)". OBLIGATORIO con la fuente http.
AVISABUS_SAE_CONTACT=<obligatorio con la fuente http>

# Fuente de los tiempos de llegada: http (el SAE real de EMT, con la caché de 20 s) por defecto.
# Para dejar de consultar a EMT sin reconstruir la imagen, cambia a la grabación incluida:
#   AVISABUS_ARRIVALS_SOURCE=replay
# y recrea el backend (docker compose up -d backend). Para volver, pon http de nuevo.
AVISABUS_ARRIVALS_SOURCE=http

# Grabación que se reproduce con la fuente replay (incluida en la imagen backend).
AVISABUS_SAE_REPLAY_DIR=/app/replay/stop_508_peak

# Correcciones del sentido: vacío (sin correcciones). Si se usa, ruta absoluta en /data, p. ej.
# /data/direction_overrides.json.
AVISABUS_DIRECTION_OVERRIDES_FILE=

# GTFS: días antes de que caduque el feed activo a partir de los cuales se avisa
# (gtfs.feed_expiring en el log una vez al día, y en /api/v1/health).
AVISABUS_GTFS_EXPIRY_WARNING_DAYS=7

# GTFS: filas por lote al importar el feed.
AVISABUS_GTFS_BATCH_SIZE=10000

# SAE: plantilla de la URL de la página de una parada (debe contener {stop_id}).
AVISABUS_SAE_URL_TEMPLATE=https://www.emtvalencia.es/QR.php?sec=est&p={stop_id}

# SAE: timeout de cada petición (s), segundos que se reutiliza la respuesta de una parada (poco
# volumen: no bajes de 20), segundos de espera tras un fallo y consultas simultáneas máximas.
AVISABUS_SAE_TIMEOUT_S=3
AVISABUS_SAE_CACHE_TTL_S=20
AVISABUS_SAE_ERROR_TTL_S=5
AVISABUS_SAE_MAX_CONCURRENCY=4

# Ocupación simulada: capacidad, asientos, semilla y umbrales de nivel.
AVISABUS_OCCUPANCY_CAPACITY=90
AVISABUS_OCCUPANCY_SEATS=28
AVISABUS_OCCUPANCY_SEED=avisabus
AVISABUS_OCCUPANCY_THRESHOLD_MEDIUM=0.50
AVISABUS_OCCUPANCY_THRESHOLD_FULL=0.85

# Llegadas: tolerancia de emparejamiento con el horario (min), respaldo por horario (ventana en
# min y pasadas por sentido) y similitud mínima del destino.
AVISABUS_TRIP_MATCH_TOLERANCE_MIN=10
AVISABUS_SCHEDULED_WINDOW_MIN=90
AVISABUS_SCHEDULED_PER_DIRECTION=2
AVISABUS_DIRECTION_MIN_SCORE=0.2

# Solicitudes de parada: antelación máxima y caducidad (min); límites por dispositivo y por IP
# en una ventana de minutos (la IP real la fija el contenedor web a partir de NPM).
AVISABUS_ALERT_MAX_LEAD_MIN=30
AVISABUS_ALERT_MAX_AGE_MIN=30
AVISABUS_ALERT_RATE_DEVICE=10
AVISABUS_ALERT_RATE_IP=30
AVISABUS_ALERT_RATE_WINDOW_MIN=10

# Caducidad de las solicitudes: intervalos de las tareas (s), ventana de paso y margen (min).
AVISABUS_PASSAGE_WATCH_INTERVAL_S=15
AVISABUS_ALERT_EXPIRY_INTERVAL_S=10
AVISABUS_PASSAGE_WINDOW_MIN=2
AVISABUS_NEXT_STOP_MARGIN_MIN=2

# WebSockets: conexiones máximas, ping (s), espera del hello (s) y cola de eventos.
AVISABUS_WS_MAX_CONNECTIONS=500
AVISABUS_WS_PING_INTERVAL_S=25
AVISABUS_WS_HELLO_TIMEOUT_S=5
AVISABUS_EVENT_QUEUE_SIZE=100

# Conductores: inactividad del turno (min), GPS desactualizado (s), bloqueo de intentos
# fallidos por IP y periodo de la tarea que cierra turnos (s).
AVISABUS_DRIVER_IDLE_TIMEOUT_MIN=10
AVISABUS_DRIVER_GPS_STALE_S=30
AVISABUS_DRIVER_LOGIN_MAX_FAILURES=5
AVISABUS_DRIVER_LOGIN_BLOCK_MIN=15
AVISABUS_DRIVER_REAPER_INTERVAL_S=60
